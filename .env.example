DATABASE_URL="postgresql://mad:mad@localhost:5432/mad?schema=public"
# generate with: openssl rand -base64 48   (min 32 chars, the app refuses to start otherwise)
JWT_SECRET=""
JWT_EXPIRES_IN="8h"
PORT=3000
# comma separated list of allowed web origins (leave empty to disable CORS)
CORS_ORIGINS="http://localhost:5173"
# used only by `npm run seed`
SEED_ADMIN_USERNAME="superadmin"
SEED_ADMIN_PASSWORD=""

# ---- attachments ----
UPLOAD_DIR="./uploads"

# ---- SMS ----
# log = development (prints instead of sending) | kavenegar
SMS_PROVIDER="log"
KAVENEGAR_API_KEY=""
KAVENEGAR_SENDER=""
# Rials per SMS part, used for the cost preview. 0 = no estimate / no credit check.
SMS_COST_PER_PART=0
# per-sender daily SMS recipient limits by role, JSON (empty = unlimited)
SMS_DAILY_LIMITS='{"SYSTEM_MANAGER":5000,"DORM_SUPERVISOR":1000}'
# set to "off" on instances that must not process the SMS queue
SMS_WORKER="on"

# force every new user to change the initial password at first login (on | off)
FORCE_PASSWORD_CHANGE="off"
